<%- include("partials/header") %>

<h1>Panel principal</h1>

<p>Bienvenido, <strong><%= usuario.nombre %></strong></p>
<p>Rol: <strong><%= usuario.rol %></strong></p>

<div class="cards">
  <div class="card">
    <h3>Total de tareas</h3>
    <p><%= totalTareas %></p>
  </div>

  <div class="card">
    <h3>Pendientes</h3>
    <p><%= pendientes %></p>
  </div>

  <div class="card">
    <h3>En proceso</h3>
    <p><%= proceso %></p>
  </div>

  <div class="card">
    <h3>Finalizadas</h3>
    <p><%= finalizadas %></p>
  </div>
</div>

<%- include("partials/footer") %>